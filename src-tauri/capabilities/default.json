{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:webview:deny-internal-toggle-devtools",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://www.100ask.net/*"
        },
        {
          "url": "https://github.com/dshanpi*"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$TEMP/usbtoolbox-cache/**"
        }
      ]
    },
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-stat",
    {
      "identifier": "fs:scope",
      "allow": [
        "$TEMP/usbtoolbox-cache",
        "$TEMP/usbtoolbox-cache/**"
      ]
    },
    "dialog:default",
    "updater:default",
    "process:default",
    "log:default"
  ]
}
